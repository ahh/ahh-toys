<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily run at 07:30 local. If the Mac is asleep then, launchd runs it on wake.
     Install:  cp com.ahh.xdigest.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.ahh.xdigest.plist
     Remove:   launchctl unload ~/Library/LaunchAgents/com.ahh.xdigest.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ahh.xdigest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--directory</string>
        <string>/Users/ahh/repo/ahh-toys/xdigest</string>
        <string>xdigest.py</string>
        <string>run</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/ahh/.local/share/xdigest/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ahh/.local/share/xdigest/launchd.log</string>
</dict>
</plist>
